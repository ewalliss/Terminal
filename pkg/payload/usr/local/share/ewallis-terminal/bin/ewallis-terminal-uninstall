#!/usr/bin/env zsh
# ─────────────────────────────────────────────────────────────────────────────
# ewallis-terminal — uninstaller
#
# Reverses everything ewallis-terminal-setup-user did, for the *current user*.
#
# Phases:
#   user   — strip marker blocks, restore backups, remove deployed files,
#            remove ~/.local/share/ewallis-terminal/.
#   system — (requires sudo) remove /usr/local/share/ewallis-terminal and
#            forget the pkg receipt.
#
# Usage:
#   ewallis-terminal-uninstall            # user phase only
#   ewallis-terminal-uninstall --system   # user phase, then sudo for system
#   ewallis-terminal-uninstall --all      # alias for --system
#   ewallis-terminal-uninstall --dry-run  # show what would happen
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail
IFS=$'\n\t'
export LANG="${LANG:-en_US.UTF-8}"

PKG_ID="com.ewalliss.ewallis-terminal"
PKG_NAME="ewallis-terminal"
PKG_ROOT="${EWALLIS_PKG_ROOT:-/usr/local/share/$PKG_NAME}"
STATE_DIR="$HOME/.local/share/$PKG_NAME"
MANIFEST="$STATE_DIR/install.manifest"

# Refuse to run as root for the user phase (we'd nuke /var/root state)
if [[ "$(id -u)" -eq 0 ]]; then
  print -u2 -- "ERROR: do not run uninstall as root. Run as the user who installed."
  print -u2 -- "       (sudo escalation for system phase is handled internally.)"
  exit 64
fi

DO_SYSTEM=0
DRY_RUN=0
while (( $# > 0 )); do
  case "$1" in
    --system|--all) DO_SYSTEM=1 ;;
    --dry-run)      DRY_RUN=1 ;;
    --help|-h)
      print -- "Usage: $0 [--system|--all] [--dry-run]"
      exit 0
      ;;
    *) print -u2 -- "unknown arg: $1"; exit 2 ;;
  esac
  shift
done

say()  { print -P -- "%F{141}==>%f $*"; }
ok()   { print -P -- "%F{114}  ok%f $*"; }
warn() { print -P -- "%F{214}  warn%f $*"; }
err()  { print -P -- "%F{196}  err%f $*"; }
run()  {
  if (( DRY_RUN )); then
    print -P -- "%F{245}  dry  $*%f"
  else
    eval -- "$@"
  fi
}

# ─── User phase ──────────────────────────────────────────────────────────────
if [[ ! -f "$MANIFEST" ]]; then
  warn "no manifest at $MANIFEST — nothing recorded for this user."
  warn "Will still attempt best-effort cleanup of marker blocks."
fi

# 1. Strip marker blocks from any known shell rc, manifest or not (defensive).
strip_marker_block() {
  local rc="$1"
  [[ -f "$rc" ]] || return 0
  if ! grep -q '^# >>> ewallis-terminal >>>' "$rc" 2>/dev/null; then
    return 0
  fi
  local tmp="$rc.tmp.$$"
  awk '
    BEGIN { in_block = 0 }
    /^# >>> ewallis-terminal >>>/ { in_block = 1; next }
    /^# <<< ewallis-terminal <<</ { in_block = 0; next }
    in_block == 0 { print }
  ' "$rc" > "$tmp"
  if (( DRY_RUN )); then
    print -P -- "%F{245}  dry  strip block from $rc%f"
    rm -f "$tmp"
  else
    mv -f "$tmp" "$rc"
    ok "stripped block: $rc"
  fi
}

# Legacy strip helper — old install.sh (pre-.pkg) injected an unmarked block.
strip_legacy_lines() {
  local rc="$1"
  [[ -f "$rc" ]] || return 0
  grep -qE '_esc_clear_line|_catppuccin_esc_clear_line' "$rc" 2>/dev/null || return 0
  if (( DRY_RUN )); then
    print -P -- "%F{245}  dry  strip legacy install.sh lines from $rc%f"
    return 0
  fi
  /usr/bin/sed -i '' \
    -e '/# Double-ESC to clear current line/d' \
    -e '/_esc_clear_line/d' \
    -e '/_catppuccin_esc_clear_line/d' \
    "$rc" 2>/dev/null && ok "stripped legacy lines: $rc"
}

# 2. Restore from backups recorded in the manifest.
# NOTE: restore runs BEFORE marker/legacy strip — otherwise restoring an old
# backup brings any pre-existing injection right back, undoing our strip.
if [[ -f "$MANIFEST" ]]; then
  say "Restoring from backups"
  while IFS=$'\t' read -r kind orig backup; do
    [[ "$kind" == "backup" ]] || continue
    if [[ -f "$backup" ]]; then
      if (( DRY_RUN )); then
        print -P -- "%F{245}  dry  restore $orig from $backup%f"
      else
        cp -p -- "$backup" "$orig"
        ok "restored: $orig"
      fi
    else
      warn "backup missing: $backup (skipping $orig)"
    fi
  done < "$MANIFEST"

  # 3. Remove deployed files that have no backup entry (= they didn't exist before).
  say "Removing files we deployed"
  # Build set of paths that were restored from backup
  typeset -A restored_set=()
  while IFS=$'\t' read -r kind orig backup; do
    [[ "$kind" == "backup" ]] || continue
    restored_set[$orig]=1
  done < "$MANIFEST"

  while IFS=$'\t' read -r kind target _; do
    [[ "$kind" == "deployed" ]] || continue
    [[ -n "${restored_set[$target]:-}" ]] && continue   # was restored — leave it
    if [[ -e "$target" ]]; then
      if (( DRY_RUN )); then
        print -P -- "%F{245}  dry  rm $target%f"
      else
        /bin/rm -f -- "$target"
        ok "removed: $target"
      fi
    fi
  done < "$MANIFEST"
fi

# 3b. Now (after restore) strip the marker block from any rc that had one,
#     plus any legacy unmarked install.sh lines.
say "Stripping marker blocks (post-restore)"
for rc in "$HOME/.zshrc" "$HOME/.zprofile" "$HOME/.bashrc" "$HOME/.bash_profile" "$HOME/.config/fish/config.fish"; do
  strip_marker_block "$rc"
done

say "Stripping legacy install.sh lines (if any)"
for rc in "$HOME/.zshrc" "$HOME/.zprofile" "$HOME/.bashrc" "$HOME/.bash_profile"; do
  strip_legacy_lines "$rc"
done

# 4. Remove per-user state dir (manifest + backups). User can keep backups
#    if they want — we leave the dir if DRY_RUN.
say "Cleaning per-user state"
if (( DRY_RUN )); then
  print -P -- "%F{245}  dry  rm -rf $STATE_DIR%f"
else
  rm -rf -- "$STATE_DIR"
  ok "removed: $STATE_DIR"
fi

# 5. Best-effort: rmdir any now-empty dirs we created (~/.config/ewallis-terminal,
#    iTerm2 DynamicProfiles only if empty). rmdir refuses non-empty dirs so this
#    is safe against accidental data loss.
say "Pruning empty directories"
for d in \
  "$HOME/.config/ewallis-terminal" \
  "$HOME/Library/Application Support/iTerm2/DynamicProfiles"
do
  if [[ -d "$d" ]] && [[ -z "$(ls -A "$d" 2>/dev/null)" ]]; then
    if (( DRY_RUN )); then
      print -P -- "%F{245}  dry  rmdir $d%f"
    else
      /bin/rmdir -- "$d" 2>/dev/null && ok "rmdir: $d"
    fi
  fi
done

# ─── System phase (requires sudo) ────────────────────────────────────────────
if (( DO_SYSTEM )); then
  print -- ""
  say "System phase — requires sudo"

  # Symlinks postinstall created in /usr/local/bin/. Remove these BEFORE wiping
  # $PKG_ROOT — otherwise they linger as broken symlinks that still show up in
  # PATH lookups.
  typeset -a SYSTEM_LINKS=(
    /usr/local/bin/ew
    /usr/local/bin/ewallis-terminal-setup-user
    /usr/local/bin/ewallis-terminal-uninstall
    /usr/local/bin/ewallis-terminal-doctor
    /usr/local/bin/ewallis-welcome
    /usr/local/bin/ewallis-theme
    /usr/local/bin/toggle-starship-theme
  )

  if (( DRY_RUN )); then
    for lnk in "${SYSTEM_LINKS[@]}"; do
      [[ -L "$lnk" || -e "$lnk" ]] && print -P -- "%F{245}  dry  sudo rm -f $lnk%f"
    done
    print -P -- "%F{245}  dry  sudo rm -rf $PKG_ROOT%f"
    print -P -- "%F{245}  dry  sudo pkgutil --forget $PKG_ID%f"
  else
    # Only invoke sudo if there's actually work needing root, to keep the
    # password prompt count minimal.
    typeset -a links_to_remove=()
    for lnk in "${SYSTEM_LINKS[@]}"; do
      [[ -L "$lnk" || -e "$lnk" ]] && links_to_remove+=("$lnk")
    done

    needs_dir_rm=0
    [[ -d "$PKG_ROOT" ]] && needs_dir_rm=1

    needs_forget=0
    /usr/sbin/pkgutil --pkg-info "$PKG_ID" >/dev/null 2>&1 && needs_forget=1

    if (( ${#links_to_remove[@]} > 0 )); then
      sudo /bin/rm -f -- "${links_to_remove[@]}"
      for lnk in "${links_to_remove[@]}"; do ok "removed symlink: $lnk"; done
    fi

    if (( needs_dir_rm )); then
      sudo /bin/rm -rf -- "$PKG_ROOT"
      ok "removed: $PKG_ROOT"
    fi

    if (( needs_forget )); then
      sudo /usr/sbin/pkgutil --forget "$PKG_ID"
      ok "forgot receipt: $PKG_ID"
    fi

    if (( ${#links_to_remove[@]} == 0 && ! needs_dir_rm && ! needs_forget )); then
      warn "system phase: nothing to do (already clean)"
    fi
  fi
else
  print -- ""
  warn "System files at $PKG_ROOT NOT removed (per-user uninstall only)."
  warn "To remove for all users:  $0 --system"
fi

print -- ""
ok "Uninstall complete. Open a new terminal."
