#!/usr/bin/env zsh
# ─────────────────────────────────────────────────────────────────────────────
# toggle-starship-theme
#   Swap between Catppuccin Mocha (dark) and Latte (light), and between
#   Style A (powerline backgrounds) and Style B (text-only colors).
#
# Usage:
#   toggle-starship-theme                # follow macOS Appearance, keep style
#   toggle-starship-theme --style A      # switch to powerline backgrounds
#   toggle-starship-theme --style B      # switch to text-only colors
#   toggle-starship-theme --variant mocha
#   toggle-starship-theme --variant latte
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

PKG_ROOT="/usr/local/share/ewallis-terminal"
TARGET="$HOME/.config/starship.toml"

[[ -d "$PKG_ROOT/configs" ]] || { print -u2 -- "ewallis-terminal not installed at $PKG_ROOT"; exit 70; }

# Detect current style by checking for a known Style-A marker in the config.
CURRENT_STYLE="B"
[[ -f "$TARGET" ]] && grep -q 'bg:mauve' "$TARGET" 2>/dev/null && CURRENT_STYLE="A"

# Detect current variant
CURRENT_VARIANT="latte"
[[ -f "$TARGET" ]] && grep -q 'catppuccin_mocha' "$TARGET" 2>/dev/null && CURRENT_VARIANT="mocha"

VARIANT=""
STYLE="$CURRENT_STYLE"
while (( $# > 0 )); do
  case "$1" in
    --style)   STYLE="${2:?}";   shift 2 ;;
    --variant) VARIANT="${2:?}"; shift 2 ;;
    *) print -u2 -- "unknown arg: $1"; exit 2 ;;
  esac
done

if [[ -z "$VARIANT" ]]; then
  if /usr/bin/defaults read -g AppleInterfaceStyle 2>/dev/null | grep -q "Dark"; then
    VARIANT="mocha"
  else
    VARIANT="latte"
  fi
fi

[[ "$STYLE" == "A" || "$STYLE" == "B" ]]            || { print -u2 -- "bad --style: $STYLE"; exit 2; }
[[ "$VARIANT" == "mocha" || "$VARIANT" == "latte" ]] || { print -u2 -- "bad --variant: $VARIANT"; exit 2; }

if [[ "$STYLE" == "A" ]]; then
  SRC="$PKG_ROOT/configs/starship-${VARIANT}.toml"
else
  SRC="$PKG_ROOT/configs/starship-${VARIANT}-b.toml"
fi
[[ -f "$SRC" ]] || { print -u2 -- "missing config: $SRC"; exit 70; }

mkdir -p "${TARGET:h}"
cp -p "$SRC" "$TARGET.tmp.$$"
mv -f "$TARGET.tmp.$$" "$TARGET"

print -P -- "%F{114}✓%f starship.toml → Catppuccin ${(C)VARIANT} (Style $STYLE)"
