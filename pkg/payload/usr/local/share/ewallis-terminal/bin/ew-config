#!/usr/bin/env zsh
# ─────────────────────────────────────────────────────────────────────────────
# ew-config — interactive feature toggle menu.
#             Invoked as `ew config` via the main dispatcher.
#
# Usage:
#   ew config              Open interactive menu (fzf if available, plain fallback)
#   ew config colors       Toggle colors directly (no menu)
#   ew config banner       Toggle banner directly (no menu)
# ─────────────────────────────────────────────────────────────────────────────
emulate -L zsh
setopt no_unset pipefail
unsetopt xtrace verbose     # never let the caller's debug flags leak into our output
export LANG="${LANG:-en_US.UTF-8}"

CFG_DIR="$HOME/.config/ewallis-terminal"
mkdir -p "$CFG_DIR"

# ─── Feature registry ────────────────────────────────────────────────────────
# Format: "key|label|description|flag_file"
# Add new toggleable features here — no other code needs to change.
typeset -a FEATURES=(
  "colors|Syntax colors|Colorize commands, paths, flags and strings as you type|$CFG_DIR/colors.disabled"
  "banner|Welcome banner|Show the EwallisTerminal banner on every new terminal window|$CFG_DIR/banner.disabled"
)

# ─── Helpers ─────────────────────────────────────────────────────────────────
is_on() { [[ ! -f "$1" ]] }

state_of() { is_on "$1" && print -- "on" || print -- "off" }

enable_feature()  { /bin/rm -f "$1" 2>/dev/null; true }
disable_feature() { touch "$1" }

toggle_feature() {
  if is_on "$1"; then disable_feature "$1"; else enable_feature "$1"; fi
}

# ANSI helpers — raw escapes so fzf --ansi renders them
_green() { printf '\033[38;2;166;227;161m%s\033[0m' "$*" }
_dim()   { printf '\033[38;2;108;112;134m%s\033[0m' "$*" }
_bold()  { printf '\033[1m%s\033[0m' "$*" }
_mauve() { printf '\033[38;2;203;166;247m%s\033[0m' "$*" }

ok()   { print -P -- "%F{114}  ✓%f $*" }
info() { print -P -- "%F{245}    $*%f" }

# ─── Build fzf menu lines ────────────────────────────────────────────────────
# One line per feature: "<key>\t<rendered display line>"
build_lines() {
  local entry key rest label desc flag state bullet state_tag
  for entry in "${FEATURES[@]}"; do
    key="${entry%%|*}"
    rest="${entry#*|}"
    label="${rest%%|*}"; rest="${rest#*|}"
    desc="${rest%%|*}"
    flag="${rest##*|}"
    state="$(state_of "$flag")"
    if [[ "$state" == "on" ]]; then
      bullet="$(_green '●')"; state_tag="$(_green '[ON] ')"
    else
      bullet="$(_dim '○')";   state_tag="$(_dim '[OFF]')"
    fi
    printf '%s\t  %s  %s  %s  %s\n' \
      "$key" "$bullet" "$state_tag" "$(_bold "$label")" "$(_dim "$desc")"
  done
}

# ─── Direct toggle (non-interactive) ─────────────────────────────────────────
direct_toggle() {
  local target="$1" entry key rest label desc flag
  for entry in "${FEATURES[@]}"; do
    key="${entry%%|*}"
    [[ "$key" != "$target" ]] && continue
    rest="${entry#*|}"
    label="${rest%%|*}"; rest="${rest#*|}"
    desc="${rest%%|*}"
    flag="${rest##*|}"
    toggle_feature "$flag"
    ok "$label: $(state_of "$flag")"
    info "takes effect in a new shell  (or: exec zsh)"
    return 0
  done
  print -u2 -- "unknown feature: $target"
  exit 2
}

# ─── FZF interactive menu ────────────────────────────────────────────────────
menu_fzf() {
  local selected key entry flag label
  while true; do
    selected="$(
      { build_lines; printf '__done__\t  %s  %s\n' "$(_mauve '⏎')" "$(_dim 'Done — close menu')"; } \
        | fzf \
            --ansi \
            --no-sort \
            --no-multi \
            --height=~12 \
            --border=rounded \
            --prompt="  config > " \
            --header="  Enter toggle · Esc quit" \
            --delimiter=$'\t' \
            --with-nth=2 \
            2>/dev/null
    )"

    [[ -z "$selected" ]] && break

    key="${selected%%$'\t'*}"
    [[ "$key" == "__done__" ]] && break

    for entry in "${FEATURES[@]}"; do
      [[ "${entry%%|*}" != "$key" ]] && continue
      flag="${entry##*|}"
      label="${entry#*|}"; label="${label%%|*}"
      toggle_feature "$flag"
      print -P -- "  %F{114}✓%f $label → $(state_of "$flag")"
    done
  done

  print -- ""
  info "Changes take effect in a new shell  (or: exec zsh)"
  print -- ""
}

# ─── Plain fallback menu (no fzf) ────────────────────────────────────────────
menu_plain() {
  local i entry key rest label desc flag state reply chosen
  while true; do
    print -- ""
    print -P -- "  %F{141}EwallisTerminal — feature toggles%f"
    print -- ""
    i=1
    for entry in "${FEATURES[@]}"; do
      key="${entry%%|*}"
      rest="${entry#*|}"
      label="${rest%%|*}"; rest="${rest#*|}"
      desc="${rest%%|*}"
      flag="${rest##*|}"
      state="$(state_of "$flag")"
      if [[ "$state" == "on" ]]; then
        print -P -- "  %F{114}[$i] ● $label%f  (on)   — $desc"
      else
        print -P -- "  %F{245}[$i] ○ $label%f  (off)  — $desc"
      fi
      (( i++ ))
    done
    print -P -- "  %F{245}[q] quit%f"
    print -- ""
    printf "  Select: "
    read -r reply < /dev/tty

    case "$reply" in
      q|Q|"") break ;;
      *)
        if [[ "$reply" =~ ^[0-9]+$ ]] && (( reply >= 1 && reply <= ${#FEATURES[@]} )); then
          chosen="${FEATURES[$reply]}"
          flag="${chosen##*|}"
          label="${chosen#*|}"; label="${label%%|*}"
          toggle_feature "$flag"
          ok "$label: $(state_of "$flag")"
        else
          print -P -- "  %F{196}invalid choice%f"
        fi
        ;;
    esac
  done

  print -- ""
  info "Changes take effect in a new shell  (or: exec zsh)"
  print -- ""
}

# ─── Entry point ─────────────────────────────────────────────────────────────
if (( $# > 0 )); then
  direct_toggle "$1"
  exit 0
fi

if command -v fzf >/dev/null 2>&1; then
  menu_fzf
else
  menu_plain
fi
